            'shlex.join(cmd)\n',

            id='generator expression',
        ),
        pytest.param(
            'import shlex\n'
            '" ".join([shlex.quote(arg) for arg in cmd])\n',

            'import shlex\n'
            'shlex.join(cmd)\n',

